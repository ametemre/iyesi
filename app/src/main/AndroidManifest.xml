<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Gerekli izinler -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- Opsiyonel: Kamera donanım gerekliliği kaldırıldı (varsayılan false) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front.autofocus" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Iyesi"
        tools:targetApi="31">

        <!-- Google Maps API anahtarı -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBPKyBmzbqUIt1xV6N-ygZc5U3d5yKcAr8" />

        <!-- Aktiviteler -->
        <activity android:name=".sokak.SokakActivity" android:exported="false" />
        <activity android:name=".social.Messaging" android:exported="false" />
        <activity android:name=".sahiplendirme.Sahiplendirme" android:exported="false" />
        <activity
            android:name=".kurmes.CameraCalibrationActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/title_activity_camera"
            android:theme="@style/Theme.Iyesi.Fullscreen" />
        <activity android:name=".kurmes.Kurmes" android:exported="false" />
        <activity android:name=".kurmes.Kurmes_dummy" android:exported="false" />
        <activity android:name=".sahiplendirme.Found" android:exported="false" />
        <activity android:name=".QRScannerActivity" android:exported="false" />
        <activity android:name=".social.ExplorePrivate" android:exported="false" />
        <activity android:name=".sahiplendirme.Welcome" android:exported="false" />
        <activity android:name=".Register" android:exported="false" />
        <activity android:name=".QR" android:exported="false" />
        <activity android:name=".social.Profile" android:exported="false" />
        <activity android:name=".Login" android:exported="false" />
        <activity android:name=".sahiplendirme.Founded" android:exported="false" />
        <activity android:name=".social.Explore" android:exported="false" />
        <activity android:name=".sahiplendirme.Companion" android:exported="false" />

        <!-- Giriş (Launcher) aktivitesi -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.kurmez.iyesi.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>