<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Profile Header -->
    <include
        android:id="@+id/profile_header"
        layout="@layout/item_conversation_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />


    <!-- RecyclerView -->
    <!-- root ...  xmlns:app="http://schemas.android.com/apk/res-auto" -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_private_explore"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/profile_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_content">
        <!-- Seçimi burada göstereceğiz -->
        <TextView
            android:id="@+id/text_selected_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Yol seçilmedi"
            app:layout_constraintTop_toBottomOf="@id/spinner_db_path"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <ListView
            android:id="@+id/item_content_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <Spinner
            android:id="@+id/spinner_db_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:layout_margin="8dp"/>
    </androidx.recyclerview.widget.RecyclerView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
