<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Profile Image -->
        <ImageView
            android:id="@+id/message_profile_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/holder"
            android:contentDescription="@string/message_header_content_description_profile_image"
            android:scaleType="centerCrop"
            android:layout_marginEnd="12dp"
            android:background="?android:attr/selectableItemBackground" />

        <!-- Message Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/message_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/message_header_text_username"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvLastMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/message_header_text_last_seen"
                android:textSize="13sp"
                android:textColor="#888888" />

        </LinearLayout>

        <!-- Options Icon -->
        <ImageView
            android:id="@+id/message_options_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/pati"
            android:contentDescription="@string/message_header_content_description_more_options"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
