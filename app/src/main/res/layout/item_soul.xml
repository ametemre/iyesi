<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/tvTitle"
        android:textStyle="bold" android:textSize="16sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/tvSub"
        android:layout_below="@id/tvTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout android:layout_alignParentEnd="true"
        android:orientation="horizontal"
        android:layout_width="wrap_content" android:layout_height="wrap_content">
        <ImageButton android:id="@+id/btnEdit" android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="@string/soul_content_description_edit" android:background="@android:color/transparent"
            android:layout_width="48dp" android:layout_height="48dp"/>
        <ImageButton android:id="@+id/btnDelete" android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="@string/soul_content_description_delete" android:background="@android:color/transparent"
            android:layout_width="48dp" android:layout_height="48dp"/>
    </LinearLayout>
</RelativeLayout>