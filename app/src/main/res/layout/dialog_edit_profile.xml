<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">

        <EditText android:id="@+id/et_username"  android:hint="Kullanıcı adı" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/et_email"     android:hint="E-posta"       android:inputType="textEmailAddress" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/et_phone"     android:hint="Telefon"       android:inputType="phone" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/et_location"  android:hint="Konum"         android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/et_avatar_url" android:hint="Avatar URL"   android:inputType="textUri" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/confirm_profile"
            android:hint="Confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
