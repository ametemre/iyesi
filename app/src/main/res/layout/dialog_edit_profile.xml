<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">

        <EditText android:id="@+id/et_username"  android:hint="@string/edit_profile_hint_username" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/et_email"     android:hint="@string/edit_profile_hint_email"       android:inputType="textEmailAddress" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/et_phone"     android:hint="@string/edit_profile_hint_phone"       android:inputType="phone" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/et_location"  android:hint="@string/edit_profile_hint_location"         android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/et_avatar_url" android:hint="@string/edit_profile_hint_avatar_url"   android:inputType="textUri" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button
            android:id="@+id/confirm_profile"
            android:hint="@string/edit_profile_button_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
