<!-- res/layout/activity_sokak.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".umay.SokakActivity">
  <!-- 1) En tepede indikatör olacak -->

  <ProgressBar
      android:id="@+id/progress_bar"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="14dp"
      android:layout_gravity="top"
      android:layout_marginTop="18dp"
      android:indeterminate="false"
      android:max="100"
      android:visibility="visible"
      android:progress="0"
      android:progressTint="@color/blue_translucent"/>
  <!-- Sağ üst köşede Spinner (dropdown) -->
  <!-- Harita kilitli mod overlay'i -->
  <View
      android:id="@+id/lock_mode_overlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#80000000"
      android:visibility="gone"
      android:clickable="true"
      android:focusable="true" />
  <fragment
      android:id="@+id/map"
      android:name="com.google.android.gms.maps.SupportMapFragment"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

  <View
      android:id="@+id/map_overlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:clickable="false"
      android:focusable="false"/>
  <LinearLayout
      android:id="@+id/spinner_container"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="top|end"
      android:weightSum="5"
      android:layout_marginTop="36dp"
      android:orientation="vertical"
      android:padding="8dp">

    <!-- 1. Satır: Mevcut “Level” Spinner (ADM seviyeleri) -->
    <LinearLayout
        android:id="@+id/row_spinner_1"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:visibility="visible"
        android:orientation="horizontal"
        android:layout_weight="1"
        android:gravity="center_vertical">

      <!-- Sağdan haritayı temizleyecek silme ikonu -->
      <ImageButton
          android:id="@+id/btn_clear_1"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginRight="9dp"
          android:layout_gravity="bottom"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="Temizle" />

      <!-- Görünür/Gizle toggler: başta ‘göz açık’ simgesi -->
      <ImageButton
          android:id="@+id/btn_toggle_1"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginRight="9dp"
          android:layout_gravity="bottom"
          android:scaleType="centerCrop"
          android:layout_marginStart="8dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="Görünür/Gizle" />

      <!-- İlk Spinner: levelOptions (ADM5,…,OSM) -->
      <Spinner
          android:id="@+id/spinner_level_1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:spinnerMode="dropdown" android:layout_marginEnd="16dp"
          android:layout_gravity="top|end"
          android:backgroundTint="@android:color/white"
          android:popupBackground="@android:color/white"  />
    </LinearLayout>

    <!-- 2. Satır: İleride içerik eklenecek ikinci Spinner -->
    <LinearLayout
        android:id="@+id/row_spinner_2"

        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:visibility="gone"
        android:orientation="horizontal"
        android:layout_weight="1"
        android:gravity="center_vertical">

      <ImageButton
          android:id="@+id/btn_clear_2"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginRight="9dp"
          android:layout_gravity="bottom"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="Temizle" />

      <ImageButton
          android:id="@+id/btn_toggle_2"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginRight="9dp"
          android:layout_gravity="bottom"
          android:scaleType="centerCrop"
          android:layout_marginStart="8dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="Görünür/Gizle" />

      <Spinner
          android:id="@+id/spinner_level_2"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:spinnerMode="dropdown"
          android:layout_marginEnd="16dp"
          android:layout_gravity="top|end"
          android:backgroundTint="@android:color/white"
          android:popupBackground="@android:color/white" />
    </LinearLayout>

    <!-- 3. Satır -->
    <LinearLayout
        android:id="@+id/row_spinner_3"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:visibility="gone"
        android:orientation="horizontal"
        android:layout_weight="1"
        android:gravity="center_vertical">

      <ImageButton
          android:id="@+id/btn_clear_3"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginRight="9dp"
          android:layout_gravity="bottom"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="Temizle" />

      <ImageButton
          android:id="@+id/btn_toggle_3"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginRight="9dp"
          android:layout_gravity="bottom"
          android:scaleType="centerCrop"
          android:layout_marginStart="8dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="Görünür/Gizle" />

      <Spinner
          android:id="@+id/spinner_level_3"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:spinnerMode="dropdown"
          android:layout_marginEnd="16dp"
          android:layout_gravity="top|end"
          android:backgroundTint="@android:color/white"
          android:popupBackground="@android:color/white" />
    </LinearLayout>

    <!-- 4. Satır -->
    <LinearLayout
        android:id="@+id/row_spinner_4"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:visibility="gone"
        android:orientation="horizontal"
        android:layout_weight="1"
        android:gravity="center_vertical">

      <ImageButton
          android:id="@+id/btn_clear_4"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginRight="9dp"
          android:layout_gravity="bottom"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="Temizle" />

      <ImageButton
          android:id="@+id/btn_toggle_4"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginRight="9dp"
          android:layout_gravity="bottom"
          android:scaleType="centerCrop"
          android:layout_marginStart="8dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="Görünür/Gizle" />

      <Spinner
          android:id="@+id/spinner_level_4"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:spinnerMode="dropdown"
          android:layout_marginEnd="16dp"
          android:layout_gravity="top|end"
          android:backgroundTint="@android:color/white"
          android:popupBackground="@android:color/white"  />
    </LinearLayout>

    <!-- 5. Satır -->
    <LinearLayout
        android:id="@+id/row_spinner_5"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:visibility="gone"
        android:orientation="horizontal"
        android:layout_weight="1"
        android:layout_gravity="top|end"
        android:gravity="center_vertical">

      <ImageButton
          android:id="@+id/btn_clear_5"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginRight="9dp"
          android:layout_gravity="bottom"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="Temizle" />

      <ImageButton
          android:id="@+id/btn_toggle_5"
          android:layout_width="18dp"
          android:layout_height="18dp"
          android:layout_marginRight="9dp"
          android:layout_gravity="bottom"
          android:scaleType="centerCrop"
          android:layout_marginStart="8dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="Görünür/Gizle" />

      <Spinner
          android:id="@+id/spinner_level_5"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:spinnerMode="dropdown"
          android:layout_marginEnd="16dp"
          android:layout_gravity="top|end"
          android:backgroundTint="@android:color/white"
          android:popupBackground="@android:color/white" />
    </LinearLayout>

  </LinearLayout>

  <!-- －－－－－－ “Barınak Bilgileri” PANELİ (Başlangıçta GÖRÜNMEZ) －－－－－－ -->
  <LinearLayout
      android:id="@+id/shelterInfoPanel"
      android:layout_width="230dp"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:layout_gravity="top"
      android:background="@color/black_overlay"
      android:elevation="8dp"
      android:layout_margin="16dp"
      android:clipToPadding="false"
      android:visibility="gone"
      android:padding="20dp">



    <!-- 2) Popülasyon Satırı -->
    <LinearLayout
        android:id="@+id/row_population"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

      <TextView
          android:id="@+id/tvPopulationLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Popülasyon:"
          android:textColor="@color/teal"
          android:textSize="16sp" />

      <TextView
          android:id="@+id/tvPopulationValue"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:text="—"
          android:textColor="@color/white"
          android:textSize="16sp"
          android:textStyle="bold" />
    </LinearLayout>

    <!-- 3) Kayıp Satırı -->
    <LinearLayout
        android:id="@+id/row_missing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

      <TextView
          android:id="@+id/tvMissingLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Kayıp:"
          android:textColor="@color/zxing_viewfinder_laser"

          android:textColorHint="@android:color/holo_red_dark"
          android:textSize="16sp" />

      <TextView
          android:id="@+id/tvMissingValue"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:text="—"
          android:textColor="@color/white"
          android:textSize="16sp"
          android:textStyle="bold" />
    </LinearLayout>
    <!-- 1) Panel Başlığı -->
    <TextView
        android:id="@+id/tvPanelTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Barınak Bilgileri"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="12dp"
        android:textColor="@android:color/black" />
    <!-- 4) Kedi Spinner Satırı -->
    <LinearLayout
        android:id="@+id/row_cat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:gravity="center_vertical">

      <TextView
          android:id="@+id/tvCatLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Kedi:"
          android:textSize="16sp"
          android:textColor="@android:color/black" />

      <Spinner
          android:id="@+id/spinnerCat"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:spinnerMode="dropdown"
          android:background="@drawable/spinner_background"
          android:popupBackground="@android:color/white" />
    </LinearLayout>

    <!-- 5) Köpek Spinner Satırı -->
    <LinearLayout
        android:id="@+id/row_dog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:gravity="center_vertical">

      <TextView
          android:id="@+id/tvDogLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Köpek:"
          android:textSize="16sp"
          android:textColor="@android:color/black" />

      <Spinner
          android:id="@+id/spinnerDog"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:spinnerMode="dropdown"
          android:background="@drawable/spinner_background"
          android:popupBackground="@android:color/white" />
    </LinearLayout>

    <!-- 6) Körmez Spinner Satırı -->
    <LinearLayout
        android:id="@+id/row_blind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:gravity="center_vertical">

      <TextView
          android:id="@+id/tvBlindLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Körmez:"
          android:textSize="16sp"
          android:textColor="@android:color/black" />

      <Spinner
          android:id="@+id/spinnerBlind"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:spinnerMode="dropdown"
          android:background="@drawable/spinner_background"
          android:popupBackground="@android:color/white" />
    </LinearLayout>


  </LinearLayout>
  <!-- －－－－－－ PANEL BİTTİ －－－－－－ -->

  <!-- Ana FAB -->
  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/main_fab"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:layout_margin="24dp"
      android:src="@drawable/pati"
      android:visibility="visible"
      android:contentDescription="Ana Menü" />

  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/ülgen_fab"
      android:contentDescription="ulgen"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:src="@drawable/coban"
      android:layout_gravity="bottom|end"
      android:scaleType="fitCenter"
      android:layout_margin="80dp"
      android:visibility="gone" />

  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/coban_fab"
      android:contentDescription="coban"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:src="@drawable/ulgen"
      android:scaleType="fitCenter"
      android:layout_gravity="bottom|end"
      android:layout_margin="120dp"
      android:visibility="gone" />

  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/acil_fab"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:src="@drawable/pati"
      android:layout_gravity="bottom|end"
      android:layout_margin="100dp"
      android:visibility="gone" />
  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/sound_fab"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerHorizontal="true"
      android:layout_centerVertical="true"
      android:visibility="gone"
      android:backgroundTint="@color/black_overlay"
      android:contentDescription="Sound"
      android:rotation="90"
      android:scaleType="fitCenter"
      android:src="@drawable/hush"
      app:maxImageSize="50dp"
      app:rippleColor="@color/teal" />
</FrameLayout>
