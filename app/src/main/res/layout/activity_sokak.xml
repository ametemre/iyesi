<!-- res/layout/activity_sokak.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".umay.SokakActivity">
  <!-- 1) En tepede indikatör olacak -->

  <ProgressBar
      android:id="@+id/progress_bar"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="14dp"
      android:layout_gravity="top"
      android:layout_marginTop="18dp"
      android:indeterminate="false"
      android:max="100"
      android:visibility="visible"
      android:progress="0"
      android:progressTint="@color/blue_translucent"/>
  <!-- Sağ üst köşede Spinner (dropdown) -->
  <!-- Harita kilitli mod overlay'i -->
  <View
      android:id="@+id/lock_mode_overlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#80000000"
      android:visibility="gone"
      android:clickable="true"
      android:focusable="true" />
  <fragment
      android:id="@+id/map"
      android:name="com.google.android.gms.maps.SupportMapFragment"
      android:layout_width="match_parent"
      android:layout_height="match_parent" />

  <View
      android:id="@+id/map_overlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:clickable="false"
      android:focusable="false"/>
  <LinearLayout
      android:id="@+id/spinner_container"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="top|end"
      android:layout_marginTop="16dp"
      android:layout_marginEnd="8dp"
      android:orientation="vertical"
      android:background="@android:color/transparent"
      android:padding="12dp"
      android:minWidth="120dp"
      android:gravity="start">

    <!-- 1. Satır: Veterinerler -->
    <LinearLayout
        android:id="@+id/row_spinner_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="4dp">

      <!-- Görünür/Gizle toggle -->
      <ImageButton
          android:id="@+id/btn_toggle_1"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_marginEnd="8dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="@string/sokak_content_description_toggle_visibility" />

      <!-- Layer adı -->
      <TextView
          android:id="@+id/layer_label_1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_layer_label_veterinarians"
          android:textSize="14sp"
          android:textColor="@android:color/black"
          android:gravity="center_vertical|end" />

      <!-- Temizle butonu -->
      <ImageButton
          android:id="@+id/btn_clear_1"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_marginStart="4dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="@string/sokak_content_description_clear"
          android:visibility="gone" />
    </LinearLayout>

    <!-- 2. Satır: Acil Yardım Alanları -->
    <LinearLayout
        android:id="@+id/row_spinner_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="4dp">

      <ImageButton
          android:id="@+id/btn_toggle_2"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_marginEnd="8dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="@string/sokak_content_description_toggle_visibility" />

      <TextView
          android:id="@+id/layer_label_2"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_layer_label_emergency_help"
          android:textSize="14sp"
          android:textColor="@android:color/black"
          android:gravity="center_vertical|end" />

      <ImageButton
          android:id="@+id/btn_clear_2"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_marginStart="4dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="@string/sokak_content_description_clear"
          android:visibility="gone" />
    </LinearLayout>

    <!-- 3. Satır: Sorumlu Alanlar -->
    <LinearLayout
        android:id="@+id/row_spinner_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="4dp">

      <ImageButton
          android:id="@+id/btn_toggle_3"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_marginEnd="8dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="@string/sokak_content_description_toggle_visibility" />

      <TextView
          android:id="@+id/layer_label_3"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_layer_label_responsible_areas"
          android:textSize="14sp"
          android:textColor="@android:color/black"
          android:gravity="center_vertical|end" />

      <ImageButton
          android:id="@+id/btn_clear_3"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_marginStart="4dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="@string/sokak_content_description_clear"
          android:visibility="gone" />
    </LinearLayout>

    <!-- 4. Satır: Yeni Eklenenler -->
    <LinearLayout
        android:id="@+id/row_spinner_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="4dp">

      <ImageButton
          android:id="@+id/btn_toggle_4"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_marginEnd="8dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="@string/sokak_content_description_toggle_visibility" />

      <TextView
          android:id="@+id/layer_label_4"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_layer_label_newly_added"
          android:textSize="14sp"
          android:textColor="@android:color/black"
          android:gravity="center_vertical|end" />

      <ImageButton
          android:id="@+id/btn_clear_4"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_marginStart="4dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="@string/sokak_content_description_clear"
          android:visibility="gone" />
    </LinearLayout>

    <!-- 5. Satır: Bakımı Gecikenler -->
    <LinearLayout
        android:id="@+id/row_spinner_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="4dp">

      <ImageButton
          android:id="@+id/btn_toggle_5"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_marginEnd="8dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="@string/sokak_content_description_toggle_visibility" />

      <TextView
          android:id="@+id/layer_label_5"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_layer_label_overdue_maintenance"
          android:textSize="14sp"
          android:textColor="@android:color/black"
          android:gravity="center_vertical|end" />

      <ImageButton
          android:id="@+id/btn_clear_5"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_marginStart="4dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="@string/sokak_content_description_clear"
          android:visibility="gone" />
    </LinearLayout>

    <!-- 6. Satır: Barınaklar -->
    <LinearLayout
        android:id="@+id/row_spinner_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="4dp">

      <ImageButton
          android:id="@+id/btn_toggle_6"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_marginEnd="8dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="@string/sokak_content_description_toggle_visibility" />

      <TextView
          android:id="@+id/layer_label_6"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_layer_label_shelters"
          android:textSize="14sp"
          android:textColor="@android:color/black"
          android:gravity="center_vertical|end" />

      <ImageButton
          android:id="@+id/btn_clear_6"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_marginStart="4dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="@string/sokak_content_description_clear"
          android:visibility="gone" />
    </LinearLayout>

    <!-- 7. Satır: Besleme Alanları -->
    <LinearLayout
        android:id="@+id/row_spinner_7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="4dp">

      <ImageButton
          android:id="@+id/btn_toggle_7"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_marginEnd="8dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="@string/sokak_content_description_toggle_visibility" />

      <TextView
          android:id="@+id/layer_label_7"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_layer_label_feeding_areas"
          android:textSize="14sp"
          android:textColor="@android:color/black"
          android:gravity="center_vertical|end" />

      <ImageButton
          android:id="@+id/btn_clear_7"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_marginStart="4dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="@string/sokak_content_description_clear"
          android:visibility="gone" />
    </LinearLayout>

    <!-- 8. Satır: Yuvalanma Alanları -->
    <LinearLayout
        android:id="@+id/row_spinner_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="4dp">

      <ImageButton
          android:id="@+id/btn_toggle_8"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_marginEnd="8dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="@string/sokak_content_description_toggle_visibility" />

      <TextView
          android:id="@+id/layer_label_8"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_layer_label_nesting_areas"
          android:textSize="14sp"
          android:textColor="@android:color/black"
          android:gravity="center_vertical|end" />

      <ImageButton
          android:id="@+id/btn_clear_8"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_marginStart="4dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="@string/sokak_content_description_clear"
          android:visibility="gone" />
    </LinearLayout>

    <!-- 9. Satır: Görevler -->
    <LinearLayout
        android:id="@+id/row_spinner_9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingHorizontal="4dp">

      <ImageButton
          android:id="@+id/btn_toggle_9"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_marginEnd="8dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_eye_open_24dp"
          android:contentDescription="@string/sokak_content_description_toggle_visibility" />

      <TextView
          android:id="@+id/layer_label_9"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_layer_label_tasks"
          android:textSize="14sp"
          android:textColor="@android:color/black"
          android:gravity="center_vertical|end" />

      <ImageButton
          android:id="@+id/btn_clear_9"
          android:layout_width="20dp"
          android:layout_height="20dp"
          android:layout_marginStart="4dp"
          android:scaleType="centerCrop"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:src="@drawable/ic_delete_24dp"
          android:contentDescription="@string/sokak_content_description_clear"
          android:visibility="gone" />
    </LinearLayout>

  </LinearLayout>

  <!-- －－－－－－ “Barınak Bilgileri” PANELİ (Başlangıçta GÖRÜNMEZ) －－－－－－ -->
  <LinearLayout
      android:id="@+id/shelterInfoPanel"
      android:layout_width="230dp"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:layout_gravity="top"
      android:background="@color/black_overlay"
      android:elevation="8dp"
      android:layout_margin="16dp"
      android:clipToPadding="false"
      android:visibility="gone"
      android:padding="20dp">



    <!-- 2) Popülasyon Satırı -->
    <LinearLayout
        android:id="@+id/row_population"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

      <TextView
          android:id="@+id/tvPopulationLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_panel_label_population"
          android:textColor="@color/teal"
          android:textSize="16sp" />

      <TextView
          android:id="@+id/tvPopulationValue"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:text="—"
          android:textColor="@color/white"
          android:textSize="16sp"
          android:textStyle="bold" />
    </LinearLayout>

    <!-- 3) Kayıp Satırı -->
    <LinearLayout
        android:id="@+id/row_missing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

      <TextView
          android:id="@+id/tvMissingLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_panel_label_missing"
          android:textColor="@color/zxing_viewfinder_laser"

          android:textColorHint="@android:color/holo_red_dark"
          android:textSize="16sp" />

      <TextView
          android:id="@+id/tvMissingValue"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:text="—"
          android:textColor="@color/white"
          android:textSize="16sp"
          android:textStyle="bold" />
    </LinearLayout>
    <!-- 1) Panel Başlığı -->
    <TextView
        android:id="@+id/tvPanelTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sokak_panel_title_shelter_info"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="12dp"
        android:textColor="@android:color/black" />
    <!-- 4) Kedi Spinner Satırı -->
    <LinearLayout
        android:id="@+id/row_cat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <TextView
          android:id="@+id/tvCatLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_panel_label_cat"
          android:textSize="16sp"
          android:textColor="@android:color/black" />

      <Spinner
          android:id="@+id/spinnerCat"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:spinnerMode="dropdown"
          android:background="@drawable/spinner_background"
          android:popupBackground="@android:color/white" />
    </LinearLayout>

    <!-- 5) Köpek Spinner Satırı -->
    <LinearLayout
        android:id="@+id/row_dog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <TextView
          android:id="@+id/tvDogLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_panel_label_dog"
          android:textSize="16sp"
          android:textColor="@android:color/black" />

      <Spinner
          android:id="@+id/spinnerDog"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:spinnerMode="dropdown"
          android:background="@drawable/spinner_background"
          android:popupBackground="@android:color/white" />
    </LinearLayout>

    <!-- 6) Körmez Spinner Satırı -->
    <LinearLayout
        android:id="@+id/row_blind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

      <TextView
          android:id="@+id/tvBlindLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/sokak_panel_label_blind"
          android:textSize="16sp"
          android:textColor="@android:color/black" />

      <Spinner
          android:id="@+id/spinnerBlind"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:spinnerMode="dropdown"
          android:background="@drawable/spinner_background"
          android:popupBackground="@android:color/white" />
    </LinearLayout>


  </LinearLayout>
  <!-- －－－－－－ PANEL BİTTİ －－－－－－ -->

  <!-- Ana FAB -->
  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/main_fab"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|end"
      android:layout_margin="24dp"
      android:src="@drawable/pati"
      android:visibility="visible"
      android:contentDescription="@string/sokak_content_description_main_menu"/>

  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/ülgen_fab"
      android:contentDescription="@string/sokak_content_description_ulgen"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:src="@drawable/coban"
      android:layout_gravity="bottom|end"
      android:scaleType="fitCenter"
      android:layout_margin="80dp"
      android:visibility="gone" />

  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/coban_fab"
      android:contentDescription="@string/sokak_content_description_coban"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:src="@drawable/ulgen"
      android:scaleType="fitCenter"
      android:layout_gravity="bottom|end"
      android:layout_margin="120dp"
      android:visibility="gone" />

  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/acil_fab"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:src="@drawable/pati"
      android:layout_gravity="bottom|end"
      android:layout_margin="100dp"
      android:visibility="gone" />
  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/sound_fab"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_centerHorizontal="true"
      android:layout_centerVertical="true"
      android:visibility="gone"
      android:backgroundTint="@color/black_overlay"
      android:contentDescription="@string/sokak_content_description_sound"
      android:rotation="90"
      android:scaleType="fitCenter"
      android:src="@drawable/hush"
      app:maxImageSize="50dp"
      app:rippleColor="@color/teal" />
</FrameLayout>
