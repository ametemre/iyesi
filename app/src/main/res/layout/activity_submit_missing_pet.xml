<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Photo Upload -->
        <ImageView
            android:id="@+id/missing_pet_photo"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:contentDescription="@string/submit_missing_pet_content_description"
            android:src="@drawable/holder" />

        <Button
            android:id="@+id/upload_photo_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/submit_missing_pet_button_upload_photo"
            android:layout_marginTop="16dp" />

        <!-- Pet Details -->
        <EditText
            android:id="@+id/pet_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/submit_missing_pet_hint_pet_name"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/pet_species"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/submit_missing_pet_hint_species"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/pet_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/submit_missing_pet_hint_color"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/pet_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/submit_missing_pet_hint_age"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/last_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/submit_missing_pet_hint_last_known_location"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/missing_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/submit_missing_pet_hint_date_missing"
            android:layout_marginTop="16dp" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/submit_missing_pet_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/submit_missing_pet_button_submit"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>